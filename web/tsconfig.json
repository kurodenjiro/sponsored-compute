{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "es2022"
    ],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "viem": [
        "node_modules/viem"
      ],
      "viem/*": [
        "node_modules/viem/*"
      ],
      "@napi-rs/keyring": [
        "node_modules/@napi-rs/keyring"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next/types/**/*.ts",
    ".next-dev-evil/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
