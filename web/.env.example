# Avalanche Fuji (testnet). Do not commit .env.local.
CHAIN_ID=43113
MERCHANT_PAYTO=0x0000000000000000000000000000000000000000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_server_only

# Current Fuji demo: self-relay pays settlement gas. Keep this server-only.
RELAYER_PRIVATE_KEY=0x

# Production/demo default. It has been verified end-to-end against the custom
# SupaDB recipient. Do not change this until another facilitator is verified
# with this exact token, chain, and recipient combination.
X402_SETTLEMENT_PROVIDER=self-relay

# @sponsored-compute/cli and @sponsored-compute/mcp are not published to npm
# yet. Until they are, set both to a GitHub spec (e.g. github:owner/repo) so
# the sponsor console's generated install command and .mcp.json actually
# resolve instead of 404ing. Remove both once the packages are on npm.
SPONSORED_CLI_SPEC=github:owner/repo
SPONSORED_MCP_SPEC=github:owner/repo
