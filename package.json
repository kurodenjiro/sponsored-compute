{
  "name": "sponsored-compute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sponsored-compute": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:web",
    "build:core": "tsc -p tsconfig.core.json",
    "build:web": "next build",
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "test": "npm run test:relay && npm run test:checkpoint && npm run test:contracts",
    "test:contracts": "npm --prefix contracts test",
    "test:checkpoint": "tsx src/checkpoint.test.ts",
    "test:relay": "tsx src/relayer.test.ts",
    "dev": "next dev -p 4030",
    "dev:evil": "EVIL=1 next dev -p 4031",
    "dev:neon": "MERCHANT_NAME=NeonLite MERCHANT_PAYTO=0x1f212B0a09393F82B7E60D18c2e663f13DA5f7F0 PRICE_ATOMIC=100000 next dev -p 4032",
    "start": "next start -p 4030",
    "cli": "tsx src/cli.ts",
    "address": "tsx src/cli.ts address",
    "challenge": "tsx src/cli.ts challenge",
    "card": "tsx src/cli.ts card",
    "balance": "tsx src/cli.ts balance"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^1.1.6",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "solc": "^0.8.36",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
