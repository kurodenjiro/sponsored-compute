{
  "name": "sponsored-compute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sponsored-compute": "./dist/src/cli.js",
    "sponsored-compute-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "//prepare": "Cho phép `npx -y --package github:<owner>/x402-hack sponsored-compute` chạy được khi chưa publish lên npm: npm chạy prepare sau khi clone git dep, nên dist/ được build tại chỗ. KHÔNG nuốt lỗi — build hỏng thì bin không tồn tại, phải thấy ngay.",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "npm run typecheck:core && npm run typecheck:mcp",
    "typecheck:core": "tsc --noEmit",
    "typecheck:mcp": "tsc -p tsconfig.mcp.json",
    "test": "npm run test:relay && npm run test:checkpoint && npm run test:contracts",
    "test:contracts": "npm --prefix contracts test",
    "test:checkpoint": "tsx src/checkpoint.test.ts",
    "test:relay": "tsx src/relayer.test.ts",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx mcp/server.ts",
    "address": "tsx src/cli.ts address",
    "challenge": "tsx src/cli.ts challenge",
    "card": "tsx src/cli.ts card",
    "balance": "tsx src/cli.ts balance"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^1.1.6",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "solc": "^0.8.36",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
